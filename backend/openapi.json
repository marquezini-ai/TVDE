        "type": "object"
      },
      "ClientLicenseIssueRequest": {
        "additionalProperties": false,
        "properties": {
          "android_id": {
            "pattern": "^[a-f0-9]{8,64}$",
            "title": "Android Id",
            "type": "string"
          },
          "expires_at_epoch_ms": {
            "exclusiveMinimum": 0.0,
            "title": "Expires At Epoch Ms",
            "type": "integer"
          },
          "license_type": {
            "const": "CUSTOM",
            "default": "CUSTOM",
