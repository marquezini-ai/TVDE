            "maxItems": 2,
            "minItems": 1,
            "title": "Platforms",
            "type": "array"
          },
          "shift": {
            "$ref": "#/components/schemas/Shift",
            "default": "ALL"
          },
          "start_date": {
            "format": "date",
            "title": "Start Date",
            "type": "string"
          },
          "value_mode": {
            "$ref": "#/components/schemas/ValueMode",
            "default": "FREE"
          }
        },
        "required": [
          "platforms",
          "metric",
          "start_date",
          "end_date"
