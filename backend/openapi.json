            "title": "Day Of Week",
            "type": "string"
          },
          "event_count": {
            "minimum": 0.0,
            "title": "Event Count",
            "type": "integer"
          },
          "median_cents": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
