        "title": "AggregateQuery",
        "type": "object"
      },
      "CardColor": {
        "enum": [
          "ALL",
          "GREEN",
          "YELLOW",
          "RED"
        ],
        "title": "CardColor",
        "type": "string"
      },
      "CategoryFilter": {
        "additionalProperties": false,
