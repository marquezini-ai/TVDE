          "net_trip_value_cents": {
            "anyOf": [
              {
                "maximum": 10000000.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Net Trip Value Cents"
          },
          "pickup_address": {
            "anyOf": [
              {
                "maxLength": 500,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pickup Address"
          },
          "pickup_distance_meters": {
            "anyOf": [
              {
                "maximum": 2000000.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pickup Distance Meters"
          },
          "pickup_duration_seconds": {
            "anyOf": [
              {
                "maximum": 172800.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pickup Duration Seconds"
          },
          "pickup_municipality": {
            "anyOf": [
              {
                "maxLength": 120,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pickup Municipality"
          },
          "platform": {
            "$ref": "#/components/schemas/Platform"
          },
          "recorded_at_epoch_ms": {
            "minimum": 0.0,
            "title": "Recorded At Epoch Ms",
            "type": "integer"
          },
          "stop_rejection": {
            "default": false,
