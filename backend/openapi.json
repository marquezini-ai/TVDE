        "additionalProperties": false,
        "properties": {
          "activation_key": {
            "maxLength": 4096,
            "minLength": 20,
            "title": "Activation Key",
            "type": "string"
          },
          "android_id": {
            "title": "Android Id",
            "type": "string"
          },
          "expires_at_epoch_ms": {
            "exclusiveMinimum": 0.0,
            "title": "Expires At Epoch Ms",
            "type": "integer"
          },
          "license_type": {
            "const": "CUSTOM",
            "default": "CUSTOM",
            "title": "License Type",
            "type": "string"
