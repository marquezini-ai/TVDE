        "enum": [
          "ACEITAR",
          "ANALISAR",
          "REJEITAR"
        ],
        "title": "Decision",
        "type": "string"
      },
      "EcPublicJwk": {
        "additionalProperties": false,
        "properties": {
          "crv": {
            "const": "P-256",
            "title": "Crv",
            "type": "string"
          },
          "kty": {
            "const": "EC",
            "title": "Kty",
            "type": "string"
          },
          "x": {
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "title": "X",
            "type": "string"
          },
          "y": {
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "title": "Y",
            "type": "string"
          }
        },
        "required": [
          "kty",
          "crv",
          "x",
          "y"
