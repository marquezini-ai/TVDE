          },
          "retryable": {
            "title": "Retryable",
            "type": "boolean"
          },
          "server_time": {
            "minimum": 0.0,
            "title": "Server Time",
            "type": "integer"
          }
        },
        "required": [
          "code",
          "message",
          "retryable",
          "request_id",
          "server_time"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorEnvelope": {
        "additionalProperties": false,
